{
  "name": "ambient-context",
  "version": "0.1.0",
  "description": "Open-source environmental context for ambient AI: surroundings from Overture Maps, forecasts from MET Norway and nearby satellite rain estimates from NOAA.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./overture": {
      "types": "./dist/overture.d.ts",
      "default": "./dist/overture.js"
    },
    "./met-norway": {
      "types": "./dist/met-norway.d.ts",
      "default": "./dist/met-norway.js"
    },
    "./noaa-rain-rate": {
      "types": "./dist/noaa-rain-rate.d.ts",
      "default": "./dist/noaa-rain-rate.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "LICENSE.dot-link",
    "h5wasm-NOTICE.txt",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "test:package": "node --test test/package.integration.mjs",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "ambient-ai",
    "ai-agents",
    "context",
    "geospatial",
    "overture-maps",
    "weather",
    "met-norway",
    "noaa",
    "precipitation"
  ],
  "homepage": "https://github.com/YusukeIt0/ambient-context#readme",
  "bugs": {
    "url": "https://github.com/YusukeIt0/ambient-context/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusukeIt0/ambient-context.git"
  },
  "dependencies": {
    "h5wasm": "0.10.3",
    "hyparquet": "1.33.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
